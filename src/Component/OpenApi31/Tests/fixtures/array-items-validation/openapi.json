{
    "openapi": "3.1.0",
    "info": {
        "title": "Array Items Validation Test",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.example.com/v1"
        }
    ],
    "paths": {},
    "components": {
        "schemas": {
            "ArrayItemsModel": {
                "type": "object",
                "properties": {
                    "uuidArray": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    "emailArray": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "email"
                        }
                    },
                    "enumArray": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["alpha", "beta", "gamma"]
                        }
                    },
                    "integerArray": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "constrainedStringArray": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 10
                        }
                    }
                }
            }
        }
    }
}
