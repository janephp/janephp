{
    "openapi": "3.1.2",
    "info": {
        "title": "Test",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.example.com/v1",
            "description": "Production server"
        }
    ],
    "paths": {
        "/price": {
            "get": {
                "operationId": "getPrice",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Price"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Price": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "string",
                        "format": "decimal-two"
                    },
                    "currency": {
                        "type": "string",
                        "format": "currency-code"
                    },
                    "discount": {
                        "type": "number",
                        "format": "percentage"
                    },
                    "comment": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
