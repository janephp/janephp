{
    "openapi": "3.1.0",
    "info": {
        "title": "Pets",
        "version": "1.0.0"
    },
    "paths": {},
    "components": {
        "schemas": {
            "Pet": {
                "type": "object",
                "discriminator": {
                    "propertyName": "petType",
                    "mapping": {
                        "cat": "#/components/schemas/Cat",
                        "dog": "#/components/schemas/Dog"
                    }
                },
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "petType": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "petType"
                ]
            },
            "Cat": {
                "description": "A representation of a cat",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Pet"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "huntingSkill": {
                                "type": "string",
                                "description": "The measured skill for hunting",
                                "default": "lazy",
                                "enum": [
                                    "clueless",
                                    "lazy",
                                    "adventurous",
                                    "aggressive"
                                ]
                            }
                        },
                        "required": [
                            "huntingSkill"
                        ]
                    }
                ]
            },
            "Dog": {
                "description": "A representation of a dog",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Pet"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "packSize": {
                                "type": "integer",
                                "description": "the size of the pack the dog is from",
                                "default": 0,
                                "minimum": 0
                            }
                        },
                        "required": [
                            "packSize"
                        ]
                    }
                ]
            },
            "Foo": {
                "type": "object",
                "title": "Foo",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                }
            },
            "Bar": {
                "type": "object",
                "title": "Bar",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                }
            },
            "FooBar": {
                "type": "object",
                "title": "FooBar",
                "properties": {
                    "what": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Foo"
                            },
                            {
                                "$ref": "#/components/schemas/Bar"
                            }
                        ],
                        "discriminator": {
                            "propertyName": "type",
                            "mapping": {
                                "foo": "#/components/schemas/Foo",
                                "bar": "#/components/schemas/Bar"
                            }
                        }
                    }
                }
            }
        }
    }
}
