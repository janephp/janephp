{
    "id": "http://json-schema.org/draft-04/schema#",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for issue 801: nullable properties on classes with extension types",
    "definitions": {
        "AdditionalProperties": {
            "type": "object",
            "properties": {
                "foo": { "type": ["string", "null"] }
            },
            "additionalProperties": true
        },
        "PatternProperties": {
            "type": "object",
            "properties": {
                "bar": { "type": ["integer", "null"] }
            },
            "patternProperties": {
                "^x-.*": {
                    "type": "string"
                }
            }
        }
    }
}
