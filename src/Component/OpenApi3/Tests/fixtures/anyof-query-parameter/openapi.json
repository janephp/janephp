{
    "openapi": "3.0.0",
    "info": {
        "title": "AnyOf Query Parameter Test",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.example.com/v1"
        }
    ],
    "paths": {
        "/domains": {
            "get": {
                "operationId": "listDomains",
                "parameters": [
                    {
                        "name": "dnssec_signing",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "nullable": true,
                            "anyOf": [
                                { "$ref": "#/components/schemas/DnssecSigningStatus" }
                            ],
                            "title": "Dnssec Signing"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "nullable": true,
                            "anyOf": [
                                { "$ref": "#/components/schemas/DomainStatus" }
                            ],
                            "title": "Status"
                        }
                    },
                    {
                        "name": "name__in",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "nullable": true,
                            "anyOf": [
                                { "type": "string" }
                            ],
                            "title": "Name  In"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of domains",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DnssecSigningStatus": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    }
                }
            },
            "DomainStatus": {
                "type": "string",
                "enum": ["active", "inactive", "suspended"],
                "title": "Domain Status"
            }
        }
    }
}
