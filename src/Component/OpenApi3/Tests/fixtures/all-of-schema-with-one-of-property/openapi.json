                "properties": {
                    "invoiceId": {
                        "type": "string",
                        "format": "uuid"
                    }
                },
                "additionalProperties": false
            },
            "Link_LinkBase": {
                "required": [
                    "discriminator"
                ],
                "type": "object",
                "properties": {
                    "discriminator": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "discriminator": {
                    "propertyName": "discriminator",
                    "mapping": {
