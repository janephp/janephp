                    "discriminator"
                ],
                "type": "object",
                "properties": {
                    "discriminator": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "discriminator": {
                    "propertyName": "discriminator",
                    "mapping": {
                        "Sales_RetrieveInvoicesRequest": "#/components/schemas/Sales_RetrieveInvoicesRequest"
                    }
                }
            },
            "Sales_InvoiceFilter": {
                "type": "object",
                "properties": {
