{
    "name": "jane-php/server",
    "type": "library",
    "description": "Jane server Library",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Leduc",
            "email": "baptiste.leduc@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jane\\Component\\Server\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    },
    "conflict": {
        "symfony/framework-bundle": "5.1.0"
    },
    "extra": {
        "branch-alias": {
            "dev-next": "7-dev"
        }
    },
    "config": {
        "process-timeout": 1800,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
