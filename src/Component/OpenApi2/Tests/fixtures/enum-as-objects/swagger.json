{
    "swagger": "2.0",
    "info": {
        "title": "Enum As Objects",
        "version": "1.0.0"
    },
    "paths": {
        "/items": {
            "get": {
                "operationId": "getItems",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Item"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Item": {
            "type": "object",
            "properties": {
                "status": {
                    "$ref": "#/definitions/ItemStatus"
                },
                "priority": {
                    "$ref": "#/definitions/Priority"
                }
            },
            "required": [
                "status",
                "priority"
            ]
        },
        "ItemStatus": {
            "type": "string",
            "description": "The status of an item",
            "enum": [
                "available",
                "out-of-stock",
                "reserved",
                "new-york",
                "NewYork"
            ]
        },
        "Priority": {
            "type": "integer",
            "description": "The priority level of an item",
            "enum": [
                1,
                2,
                3
            ]
        }
    }
}
