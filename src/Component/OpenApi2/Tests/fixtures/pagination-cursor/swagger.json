{
  "swagger": "2.0",
  "info": {"title": "Cursor pagination", "version": "1.0.0"},
  "produces": ["application/json"],
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {"name": "cursor", "in": "query", "type": "string"},
          {"name": "limit", "in": "query", "type": "integer", "default": 20}
        ],
        "responses": {
          "200": {"description": "A page of items", "schema": {"$ref": "#/definitions/ItemPage"}}
        }
      }
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
    },
    "ItemPage": {
      "type": "object",
      "properties": {
        "data": {"type": "array", "items": {"$ref": "#/definitions/Item"}},
        "meta": {"$ref": "#/definitions/PageMeta"}
      }
    },
    "PageMeta": {
      "type": "object",
      "properties": {"nextCursor": {"type": "string", "x-nullable": true}}
    }
  }
}
